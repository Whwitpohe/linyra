out/
node_modules/
*.vsix
.vscode/
.vscode-test/
.superpowers/

# Impeccable is installed, not vendored:
#   npx impeccable install --providers=claude --scope=project
# Keeping its Apache-2.0 payload (and a platform binary) out of this MIT repo
# avoids mixing licenses and committing a 3rd-party build artifact.
.claude/skills/impeccable/
.claude/agents/impeccable-*.md
.claude/settings.local.json
PRODUCT.md.bak

# Dev-only browser harness build output (the harness SOURCE is committed)
dev/harness/dist/
# Playwright UI test output (npm run test:ui)
dev/harness/test-results/
dev/harness/playwright-report/
test-results/
playwright-report/

# Denylist entries (employer, internal repo/service/branch/ticket/module names).
# Never committed; CI reads the same list from the LINYRA_DENYLIST secret.
.denylist

# Browser-automation snapshots and console logs (can capture whatever was on screen).
.playwright-mcp/
dev/demo/out/
