    "configuration": {
      "title": "Polylog",
      "properties": {
        "polylog.pageSize": {
          "type": "number",
          "default": 200,
          "minimum": 1,
          "maximum": 1000,
          "description": "Commits fetched per repository per page."
        },
        "polylog.maxConcurrency": {
          "type": "number",
          "default": 16,
          "minimum": 1,
          "maximum": 64,
          "description": "Maximum number of git processes running at once."
        },
        "polylog.scanDepth": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "maximum": 6,
          "markdownDescription": "Folder levels to search the workspace folders for repositories. Polylog shows these together with the repositories the Git extension has open. See also `#git.repositoryScanMaxDepth#`."
        },
        "polylog.excludeRepos": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Glob patterns for repositories to leave out, matched against the repository folder name and its full path."
        },
        "polylog.profiles": {
          "type": "object",
          "scope": "window",
          "default": {},
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "markdownDescription": "Named groups of repositories for the Repo List, e.g. `{ \"backend\": [\"acme-api\", \"acme-libs\"] }`. Each repository is its path relative to the workspace folder (`.` for the folder itself; in a multi-root workspace, the folder's name first). Saved from the Repo List; clicking a profile ticks its repositories and changes no other filter."
        },
        "polylog.blame": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show who last changed the cursor's line in Polylog's diffs and revisions, as of the commit shown. The text follows `#git.blame.editorDecoration.template#`."
        }
      }
    }
