        "category": "Polylog"
      },
      {
        "command": "polylog.repoOpenFolder",
        "title": "Open Folder in New Window",
        "category": "Polylog"
      },
      {
        "command": "polylog.repoCopyPath",
        "title": "Copy Path",
        "category": "Polylog"
      },
      {
        "command": "polylog.profileSwitch",
        "title": "Switch Profile…",
        "category": "Polylog"
      },
      {
        "command": "polylog.profileShow",
        "title": "Show This Profile",
        "category": "Polylog"
      },
      {
        "command": "polylog.profileSave",
        "title": "Save Selection as Profile…",
        "category": "Polylog"
      },
      {
        "command": "polylog.profileUpdate",
        "title": "Update to Current Selection",
        "category": "Polylog"
      },
      {
        "command": "polylog.profileRename",
        "title": "Rename…",
        "category": "Polylog"
      },
      {
        "command": "polylog.profileDelete",
        "title": "Delete",
        "category": "Polylog"
      },
      {
        "command": "polylog.repoProfiles",
        "title": "Profiles…",
        "category": "Polylog"
      },
      {
        "command": "polylog.fetchAll",
        "title": "Fetch All Repositories",
        "category": "Polylog",
        "icon": "$(cloud-download)"
      },
      {
        "command": "polylog.fetching",
        "title": "Fetching All Repositories…",
        "category": "Polylog",
        "icon": "$(sync~spin)"
      },
      {
        "command": "polylog.showBehind",
        "title": "Show Only Repositories Behind",
        "category": "Polylog"
      },
      {
        "command": "polylog.pullAllBehind",
        "title": "Pull All Repositories Behind",
        "category": "Polylog"
      },
      {
        "command": "polylog.fetchAndPullAll",
        "title": "Fetch and Pull All Repositories",
        "category": "Polylog"
      },
      {
        "command": "polylog.commitCopySha",
        "title": "Copy Commit ID",
        "category": "Polylog"
      },
      {
        "command": "polylog.commitCopyMessage",
        "title": "Copy Message",
        "category": "Polylog"
      },
      {
        "command": "polylog.commitOpenOnRemote",
        "title": "Open on Remote",
        "category": "Polylog"
      },
      {
        "command": "polylog.repoPull",
        "title": "Pull",
        "category": "Polylog"
      },
      {
        "command": "polylog.focusUncommitted",
        "title": "Open Uncommitted View",
        "category": "Polylog",
        "icon": "$(diff-modified)"
      },
      {
        "command": "polylog.refreshUncommitted",
        "title": "Refresh Uncommitted",
        "category": "Polylog",
        "icon": "$(refresh)"
      },
      {
        "command": "polylog.stage",
        "title": "Stage Changes",
        "category": "Polylog",
        "icon": "$(add)"
      },
      {
        "command": "polylog.stageAll",
        "title": "Stage All Changes",
        "category": "Polylog",
        "icon": "$(add)"
      },
      {
        "command": "polylog.unstage",
        "title": "Unstage Changes",
        "category": "Polylog",
        "icon": "$(remove)"
      },
      {
        "command": "polylog.unstageAll",
        "title": "Unstage All Changes",
        "category": "Polylog",
        "icon": "$(remove)"
      },
      {
        "command": "polylog.discard",
        "title": "Discard Changes",
        "category": "Polylog",
        "icon": "$(discard)"
      },
      {
        "command": "polylog.discardAll",
        "title": "Discard All Changes",
        "category": "Polylog",
        "icon": "$(discard)"
      },
      {
        "command": "polylog.commitRepo",
        "title": "Commit…",
        "category": "Polylog",
        "icon": "$(check)"
      },
      {
        "command": "polylog.openUncommittedDiff",
        "title": "Open Diff",
        "category": "Polylog"
      },
      {
        "command": "polylog.changesShowAll",
        "title": "Show All Files",
        "category": "Polylog",
        "icon": "$(list-tree)"
      },
      {
        "command": "polylog.changesShowChanged",
        "title": "Show Changed Files",
        "category": "Polylog",
        "icon": "$(diff)"
      },
      {
        "command": "polylog.openRevision",
        "title": "Open File at Commit",
