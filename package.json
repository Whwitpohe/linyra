      },
      {
        "command": "polylog.compareShowSame",
        "title": "Show Files Already on Both",
        "category": "Polylog",
        "icon": "$(filter-filled)"
      },
      {
        "command": "polylog.compareRefresh",
        "title": "Refresh",
