{
  "name": "polylog-git",
  "displayName": "Polylog — Multi-Repo Git Log",
  "description": "One git log across every repository in your workspace. Search commit messages, filter by author, branch and date across all of them at once, and open any change in the native diff editor.",
  "version": "1.2.0",
  "publisher": "lntvan166",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1c0e0b",
    "theme": "dark"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lntvan166/polylog"
  },
  "bugs": {
    "url": "https://github.com/lntvan166/polylog/issues"
  },
  "homepage": "https://github.com/lntvan166/polylog#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "keywords": [
    "git",
    "log",
    "history",
    "multi-repo",
    "monorepo",
    "polyrepo",
    "multi-root",
    "commits",
    "workspace",
    "git log",
    "git history",
    "file history",
    "multi repository",
    "search commits"
  ],
  "activationEvents": [
    "onCommand:polylog.fileHistory",
    "onCommand:polylog.open",
    "onView:polylog.changes",
    "onView:polylog.log",
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "polylog",
          "title": "Polylog",
          "icon": "media/polylog.svg"
        },
        {
          "id": "polylog-compare",
          "title": "Polylog Compare",
          "icon": "media/compare.svg"
        }
      ],
      "activitybar": [
        {
          "id": "polylog-side",
          "title": "Polylog",
          "icon": "media/polylog.svg"
        }
      ]
    },
    "views": {
      "polylog": [
        {
          "type": "webview",
          "id": "polylog.log",
          "name": "Log",
          "initialSize": 1100,
          "icon": "$(history)"
        },
        {
          "id": "polylog.changes",
          "name": "Changes",
          "initialSize": 450,
          "icon": "$(diff)"
        }
      ],
      "polylog-compare": [
        {
          "id": "polylog.compare",
          "name": "Repositories",
          "icon": "$(repo)",
          "when": "polylog.compareShown",
          "type": "webview"
        },
        {
          "id": "polylog.compareLeft",
          "name": "Left",
          "icon": "$(arrow-left)",
          "when": "polylog.compareShown"
        },
        {
          "id": "polylog.compareRight",
          "name": "Right",
          "icon": "$(arrow-right)",
          "when": "polylog.compareShown"
        }
      ],
      "polylog-side": [
        {
          "id": "polylog.uncommitted",
          "name": "Uncommitted",
          "initialSize": 450,
          "icon": "$(diff-modified)",
          "when": "polylog.uncommittedShown"
        }
      ]
    },
    "commands": [
      {
        "command": "polylog.open",
        "title": "Open Merged Log",
        "category": "Polylog"
      },
      {
        "command": "polylog.openDiff",
        "title": "Open Diff",
        "category": "Polylog"
      },
      {
        "command": "polylog.copySha",
        "title": "Copy Commit ID",
        "category": "Polylog"
      },
      {
        "command": "polylog.copyMessage",
        "title": "Copy Message",
        "category": "Polylog"
      },
      {
        "command": "polylog.showRepos",
        "title": "Group by Repository",
        "category": "Polylog",
        "icon": "$(list-tree)"
      },
      {
        "command": "polylog.hideRepos",
        "title": "Hide Repositories",
        "category": "Polylog",
        "icon": "$(list-flat)"
      },
      {
        "command": "polylog.fileHistory",
        "title": "Polylog: File History",
        "icon": "$(history)"
      },
      {
        "command": "polylog.openWorkingFile",
        "title": "Open File",
        "category": "Polylog",
        "icon": "$(go-to-file)"
      },
      {
        "command": "polylog.copyFilePath",
        "title": "Copy Path",
        "category": "Polylog"
      },
      {
        "command": "polylog.copyRelativePath",
        "title": "Copy Relative Path",
        "category": "Polylog"
      },
      {
        "command": "polylog.repoShowOnly",
        "title": "Show Only This Repository",
        "category": "Polylog"
      },
      {
        "command": "polylog.repoHide",
        "title": "Hide from the Log",
        "category": "Polylog"
      },
      {
        "command": "polylog.repoShowAll",
        "title": "Show All Repositories",
        "category": "Polylog"
      },
      {
        "command": "polylog.repoExclude",
