      },
      {
        "command": "polylog.compareWith",
        "title": "Compare with…",
        "category": "Polylog"
      },
      {
        "command": "polylog.comparePick",
        "title": "Pick Branches…",
        "category": "Polylog",
        "icon": "$(git-branch)"
      },
      {
        "command": "polylog.compareSwap",
        "title": "Swap Sides",
        "category": "Polylog",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "polylog.compareShowCommits",
        "title": "Show Commits",
        "category": "Polylog",
        "icon": "$(git-commit)"
      },
      {
        "command": "polylog.compareShowFiles",
        "title": "Show Files",
        "category": "Polylog",
        "icon": "$(files)"
      },
      {
        "command": "polylog.compareHideSame",
        "title": "Hide Files Already on Both",
        "category": "Polylog",
