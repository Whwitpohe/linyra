    "menus": {
      "view/item/context": [
        {
          "command": "polylog.openWorkingFile",
          "when": "view == polylog.changes && viewItem =~ /^file(\\.|$)/",
          "group": "1_open@1"
        },
        {
          "command": "polylog.fileHistory",
          "when": "view == polylog.changes && viewItem =~ /^file/",
          "group": "2_history@1"
        },
        {
          "command": "polylog.discard",
          "when": "view == polylog.changes && viewItem =~ /^file(Deleted)?\\.discardable/",
          "group": "3_modification@3"
        },
        {
          "command": "polylog.stage",
          "when": "view == polylog.changes && viewItem =~ /^file(Deleted)?\\.discardable.*\\.changed$/",
          "group": "3_modification@1"
        },
        {
          "command": "polylog.unstage",
          "when": "view == polylog.changes && viewItem =~ /^file(Deleted)?\\.discardable\\.staged/",
          "group": "3_modification@2"
        },
        {
          "command": "polylog.commitRepo",
          "when": "view == polylog.changes && viewItem =~ /^uncommitted\\.discardable/",
          "group": "1_modification@1"
        },
        {
          "command": "polylog.discardAll",
          "when": "view == polylog.changes && viewItem =~ /^uncommitted\\.discardable/",
          "group": "1_modification@5"
        },
        {
          "command": "polylog.commitRepo",
          "when": "view == polylog.uncommitted && viewItem =~ /^repo\\.stageable/",
          "group": "inline@1"
        },
        {
          "command": "polylog.discard",
          "when": "view == polylog.uncommitted && viewItem =~ /^(group|folder|file)\\.(staged|changes)(\\.untracked|\\.deleted)?$/",
          "group": "inline@1"
        },
        {
          "command": "polylog.stage",
          "when": "view == polylog.uncommitted && viewItem =~ /^(group|folder|file)\\.changes(\\.untracked|\\.deleted)?$/",
          "group": "inline@2"
        },
        {
          "command": "polylog.unstage",
          "when": "view == polylog.uncommitted && viewItem =~ /^(group|folder|file)\\.staged(\\.deleted)?$/",
          "group": "inline@2"
        },
        {
          "command": "polylog.commitRepo",
          "when": "view == polylog.uncommitted && viewItem =~ /^repo\\.stageable/",
          "group": "1_modification@1"
        },
        {
          "command": "polylog.stage",
          "when": "view == polylog.uncommitted && viewItem =~ /^(group|folder|file)\\.changes(\\.untracked|\\.deleted)?$/",
          "group": "1_modification@2"
        },
        {
          "command": "polylog.unstage",
          "when": "view == polylog.uncommitted && viewItem =~ /^(group|folder|file)\\.staged(\\.deleted)?$/",
          "group": "1_modification@2"
        },
        {
          "command": "polylog.discard",
          "when": "view == polylog.uncommitted && viewItem =~ /^(group|folder|file)\\.(staged|changes)(\\.untracked|\\.deleted)?$/",
          "group": "1_modification@3"
        },
        {
          "command": "polylog.discardAll",
          "when": "view == polylog.uncommitted && viewItem =~ /^repo\\.stageable/",
          "group": "1_modification@2"
        },
        {
          "command": "polylog.repoPull",
          "when": "view == polylog.uncommitted && viewItem =~ /^repo\\./ && viewItem =~ /\\.behind$/",
          "group": "0_sync@1"
        },
        {
          "command": "polylog.repoShowOnly",
          "when": "view == polylog.uncommitted && viewItem =~ /^repo\\./",
          "group": "5_filter@1"
        },
        {
          "command": "polylog.repoHide",
          "when": "view == polylog.uncommitted && viewItem =~ /^repo\\./",
          "group": "5_filter@2"
        },
        {
          "command": "polylog.repoOpenFolder",
          "when": "view == polylog.uncommitted && viewItem =~ /^repo\\./",
          "group": "6_open@1"
        },
        {
          "command": "polylog.repoCopyPath",
          "when": "view == polylog.uncommitted && viewItem =~ /^repo\\./",
          "group": "7_copy@1"
        },
        {
          "command": "polylog.openWorkingFile",
          "when": "view == polylog.uncommitted && viewItem =~ /^file\\.(staged|changes)(\\.untracked)?(\\.readonly)?$/",
          "group": "2_open@1"
        },
        {
          "command": "polylog.fileHistory",
          "when": "view == polylog.uncommitted && viewItem =~ /^file\\.(staged|changes)(\\.deleted)?(\\.readonly)?$/",
          "group": "3_history@1"
        },
        {
          "command": "polylog.compareOpenSinceSplit",
          "when": "(view == polylog.compareLeft || view == polylog.compareRight) && viewItem =~ /^compareFile/",
          "group": "1_open@1"
        },
        {
          "command": "polylog.commitCopySha",
          "when": "view == polylog.changes && viewItem == commit || (view == polylog.compareLeft || view == polylog.compareRight) && viewItem == compareCommit",
          "group": "0_commit@1"
        },
        {
          "command": "polylog.commitCopyMessage",
          "when": "view == polylog.changes && viewItem == commit || (view == polylog.compareLeft || view == polylog.compareRight) && viewItem == compareCommit",
          "group": "0_commit@2"
        },
        {
          "command": "polylog.commitOpenOnRemote",
          "when": "view == polylog.changes && viewItem == commit || (view == polylog.compareLeft || view == polylog.compareRight) && viewItem == compareCommit",
          "group": "0_commit@3"
        },
        {
          "command": "polylog.openWorkingFile",
          "when": "(view == polylog.compareLeft || view == polylog.compareRight) && viewItem =~ /^compare(Commit)?File$/",
          "group": "1_open@2"
        },
        {
          "command": "polylog.fileHistory",
          "when": "(view == polylog.compareLeft || view == polylog.compareRight) && viewItem =~ /^compare(Commit)?File/",
          "group": "2_history@1"
        },
        {
          "command": "polylog.copyFilePath",
          "when": "(view == polylog.changes && viewItem =~ /^(file|folder)/) || (view == polylog.uncommitted && viewItem =~ /^(file|folder)\\./) || ((view == polylog.compareLeft || view == polylog.compareRight) && viewItem =~ /^compare(Commit)?File/)",
          "group": "8_copy@1"
        },
        {
          "command": "polylog.copyRelativePath",
          "when": "(view == polylog.changes && viewItem =~ /^(file|folder)/) || (view == polylog.uncommitted && viewItem =~ /^(file|folder)\\./) || ((view == polylog.compareLeft || view == polylog.compareRight) && viewItem =~ /^compare(Commit)?File/)",
          "group": "8_copy@2"
        },
        {
          "command": "polylog.stageAll",
          "when": "view == polylog.uncommitted && viewItem =~ /^repo\\.stageable.*\\.hasChanges/",
          "group": "1_modification@3"
        },
        {
          "command": "polylog.unstageAll",
          "when": "view == polylog.uncommitted && viewItem =~ /^repo\\.stageable.*\\.hasStaged/",
          "group": "1_modification@4"
        },
        {
          "command": "polylog.repoShowAll",
          "when": "view == polylog.uncommitted && viewItem =~ /^repo\\./ && polylog.repoFiltered",
          "group": "5_filter@3"
        },
        {
          "command": "polylog.repoExclude",
          "when": "view == polylog.uncommitted && viewItem =~ /^repo\\./",
          "group": "8_exclude@1"
        },
        {
          "command": "polylog.stageAll",
          "when": "view == polylog.changes && viewItem =~ /^uncommitted\\.discardable.*\\.changed/",
          "group": "1_modification@3"
        },
        {
          "command": "polylog.unstageAll",
          "when": "view == polylog.changes && viewItem =~ /^uncommitted\\.discardable\\.staged/",
          "group": "1_modification@4"
        },
        {
          "command": "polylog.stage",
          "when": "view == polylog.changes && viewItem =~ /^folder\\.discardable.*\\.changed/",
          "group": "3_modification@1"
        },
        {
          "command": "polylog.unstage",
          "when": "view == polylog.changes && viewItem =~ /^folder\\.discardable\\.staged/",
          "group": "3_modification@2"
        },
        {
          "command": "polylog.discard",
          "when": "view == polylog.changes && viewItem =~ /^folder\\.discardable/",
          "group": "3_modification@3"
        },
        {
          "command": "polylog.openWorkingFile",
          "when": "view == polylog.uncommitted && viewItem =~ /^file\\.(staged|changes)(\\.untracked)?(\\.readonly)?$/",
          "group": "inline@0"
        }
      ],
      "commandPalette": [
        {
          "command": "polylog.openDiff",
          "when": "false"
        },
        {
          "command": "polylog.copySha",
          "when": "false"
        },
        {
          "command": "polylog.copyMessage",
          "when": "false"
        },
        {
          "command": "polylog.fetching",
          "when": "false"
        },
        {
          "command": "polylog.fileHistory",
          "when": "resourceScheme == file || resourceScheme == polylog"
        },
        {
          "command": "polylog.openWorkingFile",
          "when": "resourceScheme == polylog"
        },
        {
          "command": "polylog.repoShowOnly",
          "when": "false"
        },
        {
          "command": "polylog.repoHide",
          "when": "false"
        },
        {
          "command": "polylog.repoShowAll",
          "when": "false"
        },
        {
          "command": "polylog.repoExclude",
          "when": "false"
        },
        {
          "command": "polylog.repoOpenFolder",
          "when": "false"
        },
        {
          "command": "polylog.repoCopyPath",
          "when": "false"
        },
        {
          "command": "polylog.commitCopySha",
          "when": "false"
        },
        {
          "command": "polylog.commitCopyMessage",
          "when": "false"
        },
        {
          "command": "polylog.commitOpenOnRemote",
          "when": "false"
        },
        {
          "command": "polylog.repoPull",
          "when": "false"
        },
        {
          "command": "polylog.stage",
          "when": "false"
        },
        {
          "command": "polylog.unstage",
          "when": "false"
        },
        {
          "command": "polylog.discard",
          "when": "false"
        },
        {
          "command": "polylog.discardAll",
          "when": "false"
        },
        {
          "command": "polylog.commitRepo",
          "when": "false"
        },
        {
          "command": "polylog.openUncommittedDiff",
          "when": "false"
        },
        {
          "command": "polylog.openRevision",
          "when": "false"
        },
        {
          "command": "polylog.compareWith",
          "when": "false"
        },
        {
          "command": "polylog.compareSwap",
          "when": "false"
        },
        {
